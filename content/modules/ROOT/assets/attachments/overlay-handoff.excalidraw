      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 51,
      "containerId": "-0dskq0pN8nq3QYw35Baf",
      "originalText": "overlay-sync validates size, schema, scope,\nrevision and digest, then atomically\nreplaces the file in a shared emptyDir",
      "lineHeight": 1.15
    },
